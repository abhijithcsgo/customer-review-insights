# Backend-oriented placeholders for shells / deployment docs.
# ASP.NET Core does not auto-load this file. Prefer User Secrets for local Development
# and real environment variables / a secret store for production.
# Never commit real credentials.

# --- SQL Server (optional override) ---
# ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=ReviewIQ;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- Google Gemini (required for live AI analysis) ---
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE

# Optional Gemini overrides
# Gemini__Model=gemini-3.5-flash-lite
# Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta
# Gemini__TimeoutSeconds=45

# --- Frontend (Vite) — use client/.env for local UI; never put Gemini keys here ---
# VITE_API_BASE_URL=http://localhost:5056
